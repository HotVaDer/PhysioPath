# Copy this file to `.env.local` (same folder) and fill it in. `.env.local` is never pushed to GitHub.

# Supabase project → Project Settings → API keys
NEXT_PUBLIC_SUPABASE_URL=
# The publishable key is safe in the browser: Row Level Security decides what it can read.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The secret key bypasses Row Level Security. Server only (sending staff invites). Never share it.
SUPABASE_SECRET_KEY=

# Cloudflare Turnstile ("not a robot" check on sign-in and sign-up): Cloudflare dashboard →
# Turnstile → add a site. The site key is public; the secret key goes in Supabase (Attack Protection).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Where the email links point (no slash at the end)
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# AI, server only (phase 3: record → review → approve). Use your own keys, with a spending limit.
# Anthropic console → API keys (program + note with Claude Opus)
ANTHROPIC_API_KEY=
# OpenAI platform → API keys (speech to text, gpt-transcribe)
OPENAI_API_KEY=

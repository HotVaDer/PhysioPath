# Copy this file to `.env` in the same folder and fill it in.
# `.env` is gitignored, so your details and password never reach GitHub.

# --- Your details (used in the email signature) ---
SENDER_NAME_GR=Στυλιανός Επώνυμο
SENDER_NAME_EN=Stylianos Surname
SENDER_PHONE=+357 99 000000
SENDER_EMAIL=you@ucy.ac.cy
COURSE_GR=ΕΠΛ679
COURSE_EN=EPL679

# Warn after this many emails in one day (keeps you out of spam filters)
DAILY_LIMIT=15

# --- Without SMTP: how the "Send" button opens your email ---
# outlook-mac = Outlook app on your Mac, outlook = Outlook on the web,
# gmail = Gmail in the browser, mailto = your default mail app
COMPOSE=outlook-mac

# --- Optional: true one-click sending, straight from the app ---
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_PASSWORD = an App Password
#        (Google Account → Security → 2-Step Verification → App passwords)
# Outlook / Microsoft 365: SMTP_HOST=smtp.office365.com, SMTP_PORT=587
#        (only works if your organisation allows SMTP sign-in)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Address shown as sender (defaults to SMTP_USER)
SMTP_FROM=

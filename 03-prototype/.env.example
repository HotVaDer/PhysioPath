# Copy this file to `.env` (same folder) and fill it in. `.env` is never pushed to GitHub.

# Claude API key from https://console.anthropic.com (Settings → API keys)
ANTHROPIC_API_KEY=

# Optional: clinic name shown at the top of the patient page
CLINIC_NAME=

# Optional: path to a different Whisper model (default: models/ggml-large-v3-turbo-q5_0.bin)
WHISPER_MODEL=

# Optional: port for the demo (default 8766)
PORT=

# Copy this file to `.env` (same folder) and fill it in. `.env` is never pushed to GitHub.

# Claude API key from https://console.anthropic.com (Settings → API keys)
ANTHROPIC_API_KEY=

# Optional: clinic name shown at the top of the patient page
CLINIC_NAME=

# Speech-to-text engine: openai (best on Cypriot dialect), azure (EU) or local (Whisper on this Mac, the default).
# See docs/transcription.md. Restart npm run dev after changing it.
SPEECH=

# OpenAI key from https://platform.openai.com (API keys), for SPEECH=openai
OPENAI_API_KEY=

# Azure Speech key and region from https://portal.azure.com (Speech resource → Keys and Endpoint), for SPEECH=azure
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Optional: path to a different Whisper model (default: models/ggml-large-v3-turbo-q5_0.bin)
WHISPER_MODEL=

# Optional: port for the demo (default 8766)
PORT=

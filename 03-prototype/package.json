{
  "name": "physiopath-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Demo: Greek voice note from a physiotherapist → patient home program + clinical note",
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "start": "node src/server.ts",
    "check": "tsc --noEmit",
    "download-model": "sh scripts/download-model.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench:speech": "node --env-file=.env --import ./scripts/app-loader.mjs scripts/speech-bench.ts",
    "dev:lan": "PHYSIOPATH_LAN=1 next dev -H 0.0.0.0 -p 3000"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "next": "^16.4.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.12"
  }
}
